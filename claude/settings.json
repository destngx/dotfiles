{
  "syncClaudeAiSkills": false,
  "permissions": {
    "allow": [
      "Read(~/projects/**)",
      "Edit(~/projects/**)"
    ],
    "additionalDirectories": [
      "~/projects"
    ]
  },
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_BUG_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Claude Docs"
    }
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/projects/dotfiles/claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/projects/dotfiles/claude/hooks/herdr-subagents.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/projects/dotfiles/claude/hooks/notify.sh capture"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/projects/dotfiles/claude/hooks/notify.sh notify"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/projects/dotfiles/claude/hooks/notify.sh notify"
          },
          {
            "type": "command",
            "command": "$HOME/projects/dotfiles/claude/hooks/herdr-bg-tasks.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/projects/dotfiles/claude/hooks/herdr-subagents.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/projects/dotfiles/claude/hooks/herdr-bg-tasks.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/projects/dotfiles/claude/hooks/herdr-subagents.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/projects/dotfiles/claude/hooks/herdr-bg-tasks.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "$HOME/projects/dotfiles/claude/statusline.sh"
  },
  "askUserQuestionTimeout": "60s",
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "autoMemoryEnabled": true,
  "theme": "auto",
  "editorMode": "vim",
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "autoDreamedEnabled": true,
  "ultracodeKeywordTrigger": false
}
